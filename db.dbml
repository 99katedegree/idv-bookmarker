// dbdiagram.io 形式。テーブル構成を変えたら必ずこのファイルも更新すること。

Table state {
  key   text [pk, note: "'refresh_token' | 'last_like_id'"]
  value text
}

Table liked_authors {
  user_id  text [pk, note: "いいねした特定ツイートの投稿者ID（除外リスト）"]
  added_at text
}

Table runs {
  run_at         text    [note: "実行日時（JST）"]
  deleted        integer [note: "削除したブックマーク数"]
  excluded_total integer [note: "除外リストの人数"]
  searched       integer [note: "検索で取得した件数"]
  excluded       integer [note: "除外した件数"]
  bookmarked     integer [note: "ブックマークした件数"]
  est_cost_usd   real    [note: "推定料金"]
  error          text    [note: "エラー内容（なければ NULL）"]
}
